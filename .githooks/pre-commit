#!/usr/bin/env sh
# Pre-commit hook: runs `npm run check` (lint, trivy scan, build, tests) before a commit is recorded.
# Opt-in: see the "Pre-commit hook" section of README.md for how to install it.

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

if npm run check; then
  exit 0
fi

echo "pre-commit: commit stopped because npm run check failed. The failing check is shown above." >&2
exit 1
